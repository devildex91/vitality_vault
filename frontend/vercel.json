{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' https://*.cloudinary.com data:; connect-src 'self' https://vitality-vault-backend-c2878a5636af.herokuapp.com;"
        }
      ]
    }
  ],
  "rewrites": [
    { 
      "source": "/(.*)", 
      "destination": "/" 
    }
  ]
}
